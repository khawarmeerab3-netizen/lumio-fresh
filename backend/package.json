{
  "name": "lumio-backend",
  "version": "1.0.0",
  "description": "Lumio API — Illuminate Your Growth",
  "main": "dist/index.js",
  "scripts": {
  "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
  "build": "node_modules/.bin/tsup src/index.ts --format cjs",
  "start": "node dist/index.js",
  "type-check": "tsc --noEmit",
  "test": "vitest run",
  "test:watch": "vitest"
},
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
